# Empaquetado para CurseForge (BigWigsMods/packager): qué se publica y qué no.
# Lo que está entre --@debug@ y --@end-debug@ queda comentado en la versión publicada
# (ES.DEV = false: sin las pestañas en desarrollo, ver Core.lua).
package-as: CraftersJournal

ignore:
  - tools
  - docs
  - .github
  - "*.py"
  - "*.md"
