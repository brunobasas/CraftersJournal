# Empaquetado para CurseForge (BigWigsMods/packager y tools/package.py): qué se
# publica y qué no.
package-as: CraftersJournal

# Notas de la versión que se ven en CurseForge
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Auctionator, dependencia opcional en CurseForge: el botón Escanear lanza su escaneo
# completo y el addon lo lee (Scanner.lua); sin él no se escanea
optional-dependencies:
  - auctionator

ignore:
  - tools
  - docs
  - dist
  - .github
  # OpenSpec (especificaciones y skills para el asistente de programación): solo en el repo
  - openspec
  - .agents
  - .claude
  - "*.py"
  - "*.md"
  # Herramientas del desarrollador (/cj whatsnew): solo en su copia. Su línea del .toc
  # va dentro de #@do-not-package@, que el empaquetador quita
  - DevTools.lua
  # Bancos del asistente de ruta (A.BANK, apagado): aún solo en la copia de desarrollo.
  # Su línea del .toc también va dentro de #@do-not-package@. El asistente se publica (beta)
  - Data/Bankers.lua
